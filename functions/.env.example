# Non-secret function config. Copy to functions/.env (or .env.<project>) before deploy.
# The ONE base URL of the web app (https, origin only). Stripe return links, emails, push deep links and the Meta/WordPress links all use it.
# Use the address that actually resolves today; switch to https://app.thorcomputer.com only after that domain's DNS points at the app.
APP_URL=https://thorcomputers.dbsworkouts.workers.dev
EMAIL_FROM=Thor Computer <no-reply@thorcomputer.com>
# Secrets are NOT stored here. Set each with:  firebase functions:secrets:set NAME
#   WP_INTAKE_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, META_APP_SECRET, META_VERIFY_TOKEN, GEMINI_API_KEY   (RESEND_API_KEY optional, see email.ts)
# Public (non-secret) Meta app id, from developers.facebook.com > your app > Settings > Basic:
META_APP_ID=
# Optional overrides: META_GRAPH_VERSION=v23.0   GEMINI_MODEL=gemini-2.5-flash
# Admin MFA rollout: false -> warn -> true. Admins enrol THEMSELVES in the app (Admin > Security); see docs/DEPLOYMENT.md 4a.
REQUIRE_ADMIN_MFA=false
