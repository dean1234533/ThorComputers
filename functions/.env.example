# Non-secret function config. Copy to functions/.env (or .env.<project>) before deploy.
APP_URL=https://app.thorcomputer.com
EMAIL_FROM=Thor Computer <no-reply@thorcomputer.com>
# Secrets are NOT stored here. Set with:  firebase functions:secrets:set RESEND_API_KEY   and   WP_INTAKE_SECRET
# Admin MFA rollout: false -> warn -> true. Admins enrol THEMSELVES in the app (Admin > Security); see docs/DEPLOYMENT.md 4a.
REQUIRE_ADMIN_MFA=false

# ---- Meta (Facebook / Instagram) Marketing API + Lead Ads (docs/DEPLOYMENT.md §8) ----
META_APP_ID=
# Optional. Defaults shown:
# META_GRAPH_VERSION=v24.0
# META_OAUTH_REDIRECT_URI=https://europe-west2-<project>.cloudfunctions.net/metaOAuthCallback
# Secrets (never here): META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN, META_TOKEN_KEY

# ---- Stripe Connect (docs/DEPLOYMENT.md §7) ----
# Secrets (never here): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_CONNECT_WEBHOOK_SECRET

# ---- AI assistant (Gemini) ----
# Secret (never here): GEMINI_API_KEY. Model and limits are set in Admin > Platform Settings > AI assistant.

# Local development only (set automatically by scripts/prepare-local.sh; ignored outside the emulator):
# STRIPE_API_HOST, META_GRAPH_BASE, GEMINI_API_BASE
