# Public Firebase web config (safe to ship; access is enforced by security rules + functions)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase console > Cloud Messaging > Web configuration)
VITE_FIREBASE_VAPID_KEY=
# Set to "true" to talk to local emulators during development
VITE_USE_EMULATORS=false
