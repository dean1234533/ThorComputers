{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thorcomputers",
  "compatibility_date": "2026-10-01",
  // Static single-page app served from the Vite build. Unknown paths fall back to index.html so /customer, /login etc. work on refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
