# Fake, public-safe values for the local Firebase emulators (project "demo-thor"). Used by `npm run dev:emulator`.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-thor.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-thor
VITE_FIREBASE_STORAGE_BUCKET=demo-thor.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_VAPID_KEY=
VITE_USE_EMULATORS=true
