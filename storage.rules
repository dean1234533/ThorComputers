rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size < 8 * 1024 * 1024; }

    // Avatars: owner writes, signed-in users read (engineer photos appear on public profiles).
    match /avatars/{userId}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.suspended != true && request.auth.uid == userId && isImage();
    }

    // Verification evidence: PRIVATE. Owner may upload/read their own; only reviewing admins can read others'.
    match /qualifications/{userId}/{file} {
      // `resource == null` = the object must not already exist, so evidence can never be silently replaced (some Storage runtimes evaluate an overwrite as `create`).
      allow create: if resource == null && signedIn() && request.auth.uid == userId && request.auth.token.role == 'engineer'
        && (isImage() || request.resource.contentType == 'application/pdf') && request.resource.size < 10 * 1024 * 1024;
      allow read: if signedIn() && (request.auth.uid == userId || (isAdmin() && 'engineers.review' in request.auth.token.perms));
      allow update, delete: if false;
    }

    // Device photos: customer uploads; owner, admins and approved engineers can view (no PII expected in photos; UI warns).
    match /requests/{userId}/{jobId}/{file} {
      allow create: if resource == null && signedIn() && request.auth.uid == userId && request.auth.token.suspended != true && isImage();
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || request.auth.token.engineerApproved == true);
      allow update, delete: if false;
    }

    // Chat attachments: participants of the conversation only.
    match /chat/{conversationId}/{file} {
      allow create: if resource == null && signedIn() && request.auth.token.suspended != true && isImage()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      allow read: if signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      allow update, delete: if false;
    }

    // Engineer progress photos: uploaded by the selected engineer once booked; readable by the customer, that engineer and job staff.
    match /jobs/{jobId}/progress/{file} {
      allow create: if resource == null && signedIn() && request.auth.token.suspended != true && isImage()
        && firestore.get(/databases/(default)/documents/repairRequests/$(jobId)).data.selectedEngineerId == request.auth.uid;
      allow read: if signedIn() && (
        firestore.get(/databases/(default)/documents/repairRequests/$(jobId)).data.customerId == request.auth.uid
        || firestore.get(/databases/(default)/documents/repairRequests/$(jobId)).data.selectedEngineerId == request.auth.uid
        || (isAdmin() && ('jobs.view' in request.auth.token.perms || 'jobs.manage' in request.auth.token.perms)));
      allow update, delete: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
